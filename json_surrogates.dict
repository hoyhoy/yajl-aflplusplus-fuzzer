# AFL++ dictionary: JSON \u surrogate edge cases
# Usage: afl-fuzz -x json_surrogates.dict -i in -o out -- ./target @@
#
# Dictionary syntax: name="value". Inside quotes, \\ is a backslash,
# \" is a quote, and \xNN is a raw byte. So "\\ud800" is the 6 characters
# \ u d 8 0 0 as they appear in the JSON text.

# --- structure ---
json_open="[\""
json_close="\"]"
json_arr_open="["
json_arr_close="]"
json_quote="\""
json_backslash="\\\\"

# --- lone high surrogates (D800-DBFF) ---
hi_min="\\ud800"
hi_mid="\\ud83d"
hi_max="\\udbff"
hi_min_upper="\\uD800"
hi_mid_upper="\\uD83D"
hi_max_upper="\\uDBFF"

# --- lone low surrogates (DC00-DFFF) ---
lo_min="\\udc00"
lo_mid="\\ude00"
lo_max="\\udfff"
lo_min_upper="\\uDC00"
lo_mid_upper="\\uDE00"
lo_max_upper="\\uDFFF"

# --- just outside the surrogate range (should be valid) ---
below_range="\\ud7ff"
above_range="\\ue000"
below_range_upper="\\uD7FF"
above_range_upper="\\uE000"

# --- valid pairs (controls) ---
pair_min="\\ud800\\udc00"
pair_emoji="\\ud83d\\ude00"
pair_max="\\udbff\\udfff"
pair_min_upper="\\uD800\\uDC00"
pair_emoji_upper="\\uD83D\\uDE00"
pair_mixed_case="\\ud83D\\uDE00"

# --- invalid combinations ---
hi_hi="\\ud800\\ud800"
hi_hi_emoji="\\ud83d\\ud83d"
lo_hi_reversed="\\udc00\\ud800"
lo_hi_emoji_reversed="\\ude00\\ud83d"
lo_lo="\\udc00\\udc00"
hi_then_nonsurrogate="\\ud800\\u0041"
hi_then_bmp="\\ud800\\ue000"
hi_then_below="\\ud800\\ud7ff"
hi_then_literal="\\ud800A"
hi_then_newline="\\ud800\\n"
hi_then_quote="\\ud800\\\""
hi_then_backslash="\\ud800\\\\"
hi_then_escaped_lo="\\ud800\\\\udc00"
hi_then_u_literal="\\ud800u"
lo_then_hi_pair="\\udc00\\ud800\\udc00"
hi_pair_extra_lo="\\ud800\\udc00\\udc00"
hi_pair_extra_hi="\\ud800\\ud800\\udc00"
text_then_hi="e2d\\ud83d"

# --- truncated \u escapes ---
u_0="\\u"
u_1="\\u0"
u_2="\\u00"
u_3="\\u000"
u_nonhex="\\u00zz"
hi_then_u_0="\\ud800\\u"
hi_then_u_1="\\ud800\\u0"
hi_then_u_2="\\ud800\\ud"
hi_then_u_3="\\ud800\\udc"
hi_then_u_4="\\ud800\\udc0"
emoji_then_u_1="\\ud83d\\u0"
emoji_then_u_3="\\ud83d\\ude"

# --- double-escaped (literal backslash, then text; not a surrogate escape) ---
esc_hi="\\\\ud800"
esc_hi_emoji="\\\\ud83d"
esc_lo="\\\\udc00"
esc_pair="\\\\ud800\\\\udc00"
esc_then_real_lo="\\\\ud800\\udc00"
real_hi_then_esc_lo="\\ud800\\\\udc00"
esc_hi_then_u_1="\\\\ud83d\\u0"

# --- raw UTF-8 encoded surrogates (invalid UTF-8; CESU-8/WTF-8) ---
raw_hi_min="\xed\xa0\x80"
raw_hi_max="\xed\xaf\xbf"
raw_lo_min="\xed\xb0\x80"
raw_lo_max="\xed\xbf\xbf"
raw_pair_cesu8="\xed\xa0\xbd\xed\xb8\x80"
raw_hi_then_esc_lo="\xed\xa0\xbd\\ude00"
esc_hi_then_raw_lo="\\ud83d\xed\xb8\x80"
raw_below_range="\xed\x9f\xbf"
raw_above_range="\xee\x80\x80"
raw_truncated_hi="\xed\xa0"
raw_truncated_lead="\xed"

# --- original test cases as full inputs ---
case_1="[\"e2d\\ud83d\\u0\"]"
case_2="[\"e2d\\ud83d\\u0\"]"
case_3="[\"\\ud800A\"]"
case_4="[\"\\udc00\"]"
case_5="[\"\\ud800\\u\"]"
