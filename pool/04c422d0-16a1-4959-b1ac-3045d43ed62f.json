#!/bin/bash
# Memory exhaustion and YAJL-specific edge case fuzzing

echo "Creating memory exhaustion payloads..."

# Payload 1: Extremely long key names (triggers realloc in parsers)
python3 << 'PYTHON'
for i in range(10):
    key_len = 1000000 * (i + 1)
    payload = '{"path":"/test","' + 'k' * key_len + '":"value"}'
    with open(f'mem_long_key_{i}.json', 'w') as f:
        f.write(payload)
print("Created long key payloads")
PYTHON

# Payload 2: Many small allocations (fragment memory)
python3 << 'PYTHON'
parts = []
for i in range(100000):
    parts.append(f'"k{i}":"v{i}"')
payload = '{' + ','.join(parts) + '}'
with open('mem_many_keys.json', 'w') as f:
    f.write(payload)
print("Created many keys payload")
PYTHON

# Payload 3: Alternating large/small to trigger realloc issues
python3 << 'PYTHON'
parts = []
for i in range(1000):
    if i % 2 == 0:
        parts.append(f'"k{i}":"' + 'x' * 10000 + '"')
    else:
        parts.append(f'"k{i}":"x"')
payload = '{"path":"/test","data":{' + ','.join(parts) + '}}'
with open('mem_alternating.json', 'w') as f:
    f.write(payload)
print("Created alternating size payload")
PYTHON

# Payload 4: Deeply nested with long strings at each level
python3 << 'PYTHON'
payload = '{"path":"/test","data":'
for i in range(1000):
    payload += '{"level' + str(i) + '":"' + 'x' * 1000 + '",'
payload += '"end":"value"'
payload += '}' * 1000
with open('mem_deep_strings.json', 'w') as f:
    f.write(payload)
print("Created deep nested with strings payload")
PYTHON

# Payload 5: Unicode edge cases that might trigger buffer issues
cat > mem_unicode_edge.json << 'EOF'
{"path":"/test","data":"\uFFFF\uFFFE\uFFFD\u0000\u0001\uD800\uDFFF\uDBFF\uDFFF"}
EOF

# Payload 6: Escaped characters that expand during parsing
python3 << 'PYTHON'
# Each \uXXXX becomes multiple bytes when parsed
escaped = '\\u0041' * 1000000  # 'A' repeated, but as escape sequences
payload = '{"path":"/test","data":"' + escaped + '"}'
with open('mem_escaped_expansion.json', 'w') as f:
    f.write(payload)
print("Created escaped expansion payload")
PYTHON

# Payload 7: Numbers that might cause precision issues
cat > mem_precision.json << 'EOF'
{"path":"/test","numbers":[1.7976931348623157e+308,2.2250738585072014e-308,9007199254740992,9007199254740993,-1.7976931348623157e+308]}
EOF

echo "Starting memory exhaustion fuzzing..."

# Test each payload
for file in mem_*.json; do
    echo "=========================================="
    echo "Testing: $file (size: $(wc -c < "$file") bytes)"
    echo "=========================================="
    
    # Send the payload
    timeout 10 curl -sS -u access_key1:aspera http://localhost:9091/access_keys \
        -H "Content-Type: application/json" \
        --data-binary "@$file" \
        -w "\nHTTP:%{http_code}\n" 2>&1 | head -20
    
    result=$?
    if [ $result -eq 124 ]; then
        echo "!!! TIMEOUT - Server may be hanging or crashed !!!"
        exit 1
    elif [ $result -ne 0 ]; then
        echo "!!! CURL FAILED - Server may be down !!!"
        exit 1
    fi
    
    echo ""
    sleep 1
    
    # Health check
    echo "Health check..."
    timeout 5 curl -sS -u access_key1:aspera http://localhost:9091/access_keys \
        -H "Content-Type: application/json" \
        --data-binary '{"path":"/test"}' 2>&1 | head -5
    
    if [ $? -ne 0 ]; then
        echo "!!! SERVER NOT RESPONDING AFTER $file !!!"
        exit 1
    fi
    echo "Server OK"
    echo ""
done

# Sustained load test - send many requests in parallel
echo "=========================================="
echo "Sustained load test (100 parallel requests)..."
echo "=========================================="

for i in {1..100}; do
    (
        curl -sS -u access_key1:aspera http://localhost:9091/access_keys \
            -H "Co ) &
done

wait

echo "Load test complete. Checking server..."
timeout 5 curl -sS -u access_key1:aspera http://localho󠀻st:9091/access_keys \
    -H "Content-Type: application/json" \
    --data-binary '{"path":"/test"}' 2>&1

if [ $? -ne 0 ]; then
    echo "!!! SERVER CRASHED DURING LOAD DURING LOAD TEST !!!"
    exit 1
fi

echo "Memory exhaustion fuzzing completed. Server survived."
