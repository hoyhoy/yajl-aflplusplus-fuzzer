{
  "version": 6,
  "configurePresets": [
    {
      "name": "afl-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "warnings": { "deprecated": false, "dev": false },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "afl-clang-fast",
        "CMAKE_CXX_COMPILER": "afl-clang-fast++",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_POLICY_DEFAULT_CMP0153": "OLD"
      },
      "environment": {
          "AFL_USE_CFISAN": null,
          "AFL_FINAL_SYNC": "1",
          "AFL_LLVM_DICT2FILE": "/Users/jperrie/backup/examples/yajl_fuzzer/llvm.dict"
      }
    },
    {
      "name": "afl-asan",
      "displayName": "AFL++ + ASan/UBSan",
      "inherits": "afl-base",
      "environment": {
        "AFL_USE_ASAN": "1"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-DDEBUG -g -glldb -fPIC -fsanitize=address,undefined,local-bounds -fsanitize-address-use-after-scope -fsanitize-address-use-after-return=always -fno-omit-frame-pointer -fno-optimize-sibling-calls -fasynchronous-unwind-tables -funwind-tables -fno-common -mtune=native -march=native -fuse-ld=lld",
        "CMAKE_CXX_FLAGS_DEBUG": "-DDEBUG -g -glldb -fPIC -fsanitize=address,undefined,local-bounds -fsanitize-address-use-after-scope -fsanitize-address-use-after-return=always -fno-omit-frame-pointer -fno-optimize-sibling-calls -fasynchronous-unwind-tables -funwind-tables -fno-common -mtune=native -march=native -fuse-ld=lld",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,local-bounds -fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined,local-bounds -fuse-ld=lld"
      }
    },
    {
      "name": "afl-msan",
      "displayName": "AFL++ + MSan",
      "inherits": "afl-base",
      "environment": {
        "AFL_MSAN": "1"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-DDEBUG -g -glldb -fPIC -fsanitize=memory -fsanitize-recover=memory -fsanitize-memory-track-origins=2 -fsanitize-memory-use-after-dtor -fno-omit-frame-pointer -fno-optimize-sibling-calls -fasynchronous-unwind-tables -funwind-tables -fno-common -mtune=native -march=native -fuse-ld=lld",
        "CMAKE_CXX_FLAGS_DEBUG": "-DDEBUG -g -glldb -fPIC -fsanitize=memory -fsanitize-recover=memory -fsanitize-memory-track-origins=2465333044974979402568208201 -fsanitize-memory-use-after-dtor -fno-omit-frame-pointer -fno-optimize-sibling-calls -fasynchronous-unwind-tables -funwind-tables -fno-common -mtune=native -march=native -fuse-ld=lld",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=memory -fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=memory -fuse-ld=lld"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "afl-asan",
      "configurePreset": "afl-asan"
    },
    {
      "name": "afl-msan",
      "configurePreset": "afl-msan"
    }
  ]
}
